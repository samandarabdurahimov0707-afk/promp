# ==========================================================================
# Prompt injenering kursi — muhit o'zgaruvchilari
# Nusxalash: .env.example → .env (lokal test uchun)
# Netlify'da: Site configuration → Environment variables
# ==========================================================================

# Narx (so'mda). Payme'ga avtomatik ravishda tiyinda yuboriladi (x100).
COURSE_PRICE=20000

# Payme Business (avtomatik to'lov va chek)
# PAYME_MERCHANT_ID — kabinetdagi merchant ID (ommaviy)
# PAYME_KEY — maxfiy kalit (kamida 8 belgi, faqat serverda)
PAYME_MERCHANT_ID=
PAYME_KEY=

# Karta o'tkazmasi (zaxira usul, qo'lda tasdiqlash)
PAYMENT_CARD_NUMBER=9860012132172771
PAYMENT_CARD_HOLDER=
# Bo'sh qoldirilsa ham sayt @abay_pg ga murojaat qiladi.
PAYMENT_TELEGRAM=abay_pg

# Admin sahifa uchun kamida 16 belgili tasodifiy maxfiy satr
ADMIN_SECRET=

# Kirish huquqi (pk_access) va sessiya (pk_session) cookie'larini imzolash
# uchun kamida 16 belgili maxfiy satr. Bo'sh bo'lsa kirish huquqi berilmaydi
# va ro'yxatdan o'tish/kirish 503 qaytaradi (fail closed).
ACCESS_SECRET=

# Ixtiyoriy: Bunny Stream (videolarni himoyalash uchun)
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# Ixtiyoriy: lokal dev server porti (standart 8123)
# PORT=8123
